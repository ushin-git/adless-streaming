# Jamendo API read access requires a developer client ID. No end-user login is used.
# Copy this value to an ignored local.properties file as jamendoClientId=YOUR_CLIENT_ID,
# or export JAMENDO_CLIENT_ID in your local shell. Do not commit credentials.
JAMENDO_CLIENT_ID=

# Release signing values are read directly from the process environment by Gradle.
# Do not commit a keystore or real passwords. Keep the keystore backed up securely.
ADLESS_RELEASE_KEYSTORE_FILE=
ADLESS_RELEASE_STORE_PASSWORD=
ADLESS_RELEASE_KEY_ALIAS=
ADLESS_RELEASE_KEY_PASSWORD=

